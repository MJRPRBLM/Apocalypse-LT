<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox 
    alignment="CENTER" 
    spacing="20.0" 
    xmlns="http://javafx.com/javafx/8.0.171" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="com.example.FrontPageController">

    <children>
        <Label text="Begin your lesson"/>
        <Button fx:id="beginButton" text="begin" onAction="#beginLessons" />
        <Label text="Select lessons below and then begin"/>
        <CheckBox fx:id="greetingsLessonCB" text="Greetings" />
        <CheckBox fx:id="introductionsLessonCB" text="Introductions" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>